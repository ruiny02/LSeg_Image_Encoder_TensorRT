cd ~/LSeg_Image_Encoder_TensorRT
cat > Dockerfile.jetson <<'EOF'
# syntax=docker/dockerfile:1.6

ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0

############################
# build stage
############################
FROM ${BASE_IMAGE} AS build
ENV DEBIAN_FRONTEND=noninteractive

# 필수 패키지: 빌드/런타임 공통 + OpenCV(GStreamer) + X11 + v4l2 + gstreamer
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-pip \
    build-essential cmake git wget curl pkg-config \
    zlib1g-dev libopenblas-dev \
    libopencv-dev python3-opencv \
    libgl1 libglib2.0-0 \
    libxext6 libxrender1 libsm6 \
    libgtk-3-0 libcanberra-gtk3-module \
    v4l-utils \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-x \
  && rm -rf /var/lib/apt/lists/*

# venv (JetPack 기본 라이브러리(tensorrt 등) 접근을 위해 system-site-packages 사용)
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN python3 -m pip install --upgrade pip setuptools wheel

# --------------------------
# (중요) JetPack 6.2용 PyTorch 설치
# - JetPack 6.2: CUDA 12.6 / TRT 10.3 기반에 맞는 wheel 인덱스 사용
# - 또한 cuSPARSELt가 없으면 torch import 시 libcusparseLt.so 이슈가 날 수 있어 미리 설치
# --------------------------
RUN set -eux; \
  if [ ! -f /usr/local/cuda/lib64/libcusparseLt.so ]; then \
    echo "[INFO] Installing cuSPARSELt (needed by recent PyTorch wheels)"; \
    wget -q https://raw.githubusercontent.com/pytorch/pytorch/5c6af2b583709f6176898c017424dc9981023c28/.ci/docker/common/install_cusparselt.sh \
      -O /tmp/install_cusparselt.sh; \
    chmod +x /tmp/install_cusparselt.sh; \
    export CUDA_VERSION=12.6; \
    bash /tmp/install_cusparselt.sh; \
    rm -f /tmp/install_cusparselt.sh; \
  fi

# JetPack 6.2용 torch/torchvision (JPL index)
RUN python3 -m pip install --no-cache-dir \
    torch==2.8.0 torchvision==0.23.0 \
    --index-url=https://pypi.jetson-ai-lab.io/jp6/cu126

# 파이썬 deps
COPY requirements/requirements.jetson.txt /tmp/requirements.jetson.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.jetson.txt

# (중요) TensorRT include/lib 경로를 /usr/local/tensorrt 로 맞춤 (C++ 빌드/코드 경로 호환)
RUN set -eux; \
  mkdir -p /usr/local/tensorrt; \
  if [ -d /usr/include/aarch64-linux-gnu ]; then \
    ln -snf /usr/include/aarch64-linux-gnu /usr/local/tensorrt/include; \
  elif [ -d /usr/include ]; then \
    ln -snf /usr/include /usr/local/tensorrt/include; \
  fi; \
  if [ -d /usr/lib/aarch64-linux-gnu ]; then \
    ln -snf /usr/lib/aarch64-linux-gnu /usr/local/tensorrt/lib; \
  elif [ -d /usr/lib ]; then \
    ln -snf /usr/lib /usr/local/tensorrt/lib; \
  fi; \
  ldconfig

# (수정) libcudart 위치 탐색 시 /usr/local/cuda 심링크를 따라가도록 수정
RUN set -eux; \
  CUDA_ROOT="$(readlink -f /usr/local/cuda || echo /usr/local/cuda)"; \
  echo "CUDA_ROOT=${CUDA_ROOT}"; \
  REAL="$(find "${CUDA_ROOT}" -name 'libcudart.so*' -type f ! -path '*/stubs/*' | sort | tail -n1)"; \
  echo "REAL_CUDART=${REAL}"; \
  test -n "${REAL}"; \
  LIB64="$(readlink -f /usr/local/cuda/lib64 2>/dev/null || true)"; \
  if [ -z "${LIB64}" ]; then LIB64="${CUDA_ROOT}/lib64"; fi; \
  mkdir -p "${LIB64}"; \
  ln -sf "${REAL}" "${LIB64}/libcudart.so"; \
  ldconfig

# C++ prebuild (docker build 시점에는 GPU 드라이버가 없을 수 있으므로 stub로 링크)
COPY CPP_Project /opt/src/CPP_Project
WORKDIR /opt/src

RUN set -eux; \
  CUDA_STUB="/usr/local/cuda/lib64/stubs/libcuda.so"; \
  cd CPP_Project/Inference_Time_Tester; \
  cmake -B build -S . -DCUDA_DRIVER_LIBRARY="${CUDA_STUB}"; \
  cmake --build build -j"$(nproc)"; \
  cd ../Feature_Extractor; \
  cmake -B build -S . -DCUDA_DRIVER_LIBRARY="${CUDA_STUB}"; \
  cmake --build build -j"$(nproc)"; \
  mkdir -p /opt/prebuilt/Inference_Time_Tester /opt/prebuilt/Feature_Extractor; \
  cp -f ../Inference_Time_Tester/build/trt_cpp_infer_time_tester /opt/prebuilt/Inference_Time_Tester/; \
  cp -f build/trt_feature_extractor /opt/prebuilt/Feature_Extractor/

############################
# runtime stage
############################
FROM ${BASE_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libopenblas-dev \
    libopencv-dev python3-opencv \
    libgl1 libglib2.0-0 \
    libxext6 libxrender1 libsm6 \
    libgtk-3-0 libcanberra-gtk3-module \
    v4l-utils \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-x \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/prebuilt /opt/prebuilt
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONPATH=/workspace
WORKDIR /workspace

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
EOF
