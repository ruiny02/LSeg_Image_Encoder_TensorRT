# syntax=docker/dockerfile:1.6

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:24.08-py3

############################
# build stage
############################
FROM ${BASE_IMAGE} AS build
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-venv python3-dev python3-pip \
    build-essential cmake git wget curl pkg-config \
    zlib1g-dev \
    libopencv-dev python3-opencv \
    libgl1 libglib2.0-0 \
    libxext6 libxrender1 libsm6 \
    libgtk-3-0 libcanberra-gtk3-module \
    v4l-utils \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-x \
    gstreamer1.0-gl \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN python3 -m pip install --upgrade pip setuptools wheel

COPY requirements/requirements.x86.txt /tmp/requirements.x86.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.x86.txt

# ★중요: pip cv2 제거 + GStreamer=YES 확인
RUN set -eux; \
  python3 -m pip uninstall -y opencv-python opencv-python-headless opencv-contrib-python opencv-contrib-python-headless || true; \
  rm -rf /usr/local/lib/python*/dist-packages/cv2 /usr/local/lib/python*/dist-packages/cv2-*.dist-info /usr/local/lib/python*/dist-packages/opencv* || true; \
  rm -rf /opt/venv/lib/python*/site-packages/cv2 /opt/venv/lib/python*/site-packages/cv2-*.dist-info /opt/venv/lib/python*/site-packages/opencv* || true; \
  python3 -c 'import cv2; print("cv2 =", cv2.__file__); print(next(l for l in cv2.getBuildInformation().splitlines() if "GStreamer" in l))'

RUN set -eux; \
  CUDA_ROOT="$(readlink -f /usr/local/cuda || echo /usr/local/cuda)"; \
  echo "CUDA_ROOT=${CUDA_ROOT}"; \
  REAL="$(find "${CUDA_ROOT}" -name 'libcudart.so*' -type f ! -path '*/stubs/*' | sort | tail -n1)"; \
  echo "REAL_CUDART=${REAL}"; \
  test -n "${REAL}"; \
  LIB64="$(readlink -f /usr/local/cuda/lib64 2>/dev/null || true)"; \
  if [ -z "${LIB64}" ]; then LIB64="${CUDA_ROOT}/lib64"; fi; \
  mkdir -p "${LIB64}"; \
  ln -sf "${REAL}" "${LIB64}/libcudart.so"; \
  arch="$(uname -m)"; \
  if [ -d "/usr/lib/${arch}-linux-gnu" ]; then \
    ln -sf "${REAL}" "/usr/lib/${arch}-linux-gnu/libcudart.so"; \
  fi; \
  ldconfig

COPY CPP_Project /opt/src/CPP_Project
WORKDIR /opt/src

RUN set -eux; \
  CUDA_STUB="/usr/local/cuda/lib64/stubs/libcuda.so"; \
  cd CPP_Project/Inference_Time_Tester; \
  cmake -B build -S . -DCUDA_DRIVER_LIBRARY="${CUDA_STUB}"; \
  cmake --build build -j"$(nproc)"; \
  cd ../Feature_Extractor; \
  cmake -B build -S . -DCUDA_DRIVER_LIBRARY="${CUDA_STUB}"; \
  cmake --build build -j"$(nproc)"; \
  mkdir -p /opt/prebuilt/Inference_Time_Tester /opt/prebuilt/Feature_Extractor; \
  cp -f ../Inference_Time_Tester/build/trt_cpp_infer_time_tester /opt/prebuilt/Inference_Time_Tester/; \
  cp -f build/trt_feature_extractor /opt/prebuilt/Feature_Extractor/

############################
# runtime stage
############################
FROM ${BASE_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-venv python3-pip \
    libopencv-dev python3-opencv \
    libgl1 libglib2.0-0 \
    libxext6 libxrender1 libsm6 \
    libgtk-3-0 libcanberra-gtk3-module \
    v4l-utils \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-x \
    gstreamer1.0-gl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/prebuilt /opt/prebuilt
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV PATH=/opt/venv/bin:$PATH

# ★중요: runtime에도 최종 제거 + 확인
RUN set -eux; \
  python3 -m pip uninstall -y opencv-python opencv-python-headless opencv-contrib-python opencv-contrib-python-headless || true; \
  rm -rf /usr/local/lib/python*/dist-packages/cv2 /usr/local/lib/python*/dist-packages/cv2-*.dist-info /usr/local/lib/python*/dist-packages/opencv* || true; \
  rm -rf /opt/venv/lib/python*/site-packages/cv2 /opt/venv/lib/python*/site-packages/cv2-*.dist-info /opt/venv/lib/python*/site-packages/opencv* || true; \
  python3 -c 'import cv2; print("cv2 =", cv2.__file__); print(next(l for l in cv2.getBuildInformation().splitlines() if "GStreamer" in l))'

ENV PYTHONPATH=/workspace
ENV QT_X11_NO_MITSHM=1

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
