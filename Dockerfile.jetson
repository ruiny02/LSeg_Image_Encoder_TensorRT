# syntax=docker/dockerfile:1.6

ARG BASE_IMAGE=nvcr.io/nvidia/l4t-jetpack:r36.4.0

############################
# build stage
############################
FROM ${BASE_IMAGE} AS build
ENV DEBIAN_FRONTEND=noninteractive

# NVIDIA Jetson apt repo 추가 (TensorRT 등 설치용)
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gnupg wget && \
    wget -qO- https://repo.download.nvidia.com/jetson/jetson-ota-public.asc | gpg --dearmor -o /usr/share/keyrings/nvidia-jetson-ota.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/nvidia-jetson-ota.gpg] https://repo.download.nvidia.com/jetson/common r36.4 main" > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    echo "deb [signed-by=/usr/share/keyrings/nvidia-jetson-ota.gpg] https://repo.download.nvidia.com/jetson/t234 r36.4 main" >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    apt-get update

# apt deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-dev python3-pip \
    build-essential cmake git wget curl pkg-config \
    zlib1g-dev libopencv-dev \
    libopenblas-base libopenmpi-dev libomp-dev \
    nvidia-tensorrt nvidia-tensorrt-dev \
  && rm -rf /var/lib/apt/lists/*

# venv (TensorRT/python3-pycuda는 시스템에 있으므로 system-site-packages)
RUN python3 -m venv --system-site-packages /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN python3 -m pip install --upgrade pip setuptools wheel
# Jetson PyTorch/pycuda (JP6.x, CUDA 12.6) from NGC PyPI; numpy<2 선행
RUN python3 -m pip install --no-cache-dir --extra-index-url https://pypi.ngc.nvidia.com \
    "numpy<2" \
    torch==2.6.0 \
    torchvision==0.21.0 \
    torchaudio==2.6.0 \
    pycuda

# 파이썬 deps (Jetson 전용)
COPY requirements/requirements.jetson.txt /tmp/requirements.jetson.txt
RUN python3 -m pip install --no-cache-dir -r /tmp/requirements.jetson.txt

# (수정) libcudart 위치 탐색 시 /usr/local/cuda 심링크를 따라가도록 수정
RUN set -eux; \
  CUDA_ROOT="$(readlink -f /usr/local/cuda || echo /usr/local/cuda)"; \
  echo "CUDA_ROOT=${CUDA_ROOT}"; \
  REAL="$(find "${CUDA_ROOT}" -name 'libcudart.so*' -type f ! -path '*/stubs/*' | sort | tail -n1)"; \
  echo "REAL_CUDART=${REAL}"; \
  test -n "${REAL}"; \
  LIB64="$(readlink -f /usr/local/cuda/lib64 2>/dev/null || true)"; \
  if [ -z "${LIB64}" ]; then LIB64="${CUDA_ROOT}/lib64"; fi; \
  mkdir -p "${LIB64}"; \
  ln -sf "${REAL}" "${LIB64}/libcudart.so"; \
  arch="$(uname -m)"; \
  if [ -d "/usr/lib/${arch}-linux-gnu" ]; then \
    ln -sf "${REAL}" "/usr/lib/${arch}-linux-gnu/libcudart.so"; \
  fi; \
  ldconfig

# C++ 소스는 복사만 해두고, 드라이버 라이브러리가 올라오는 런타임 환경에서 빌드
COPY CPP_Project /opt/src/CPP_Project
WORKDIR /opt/src
RUN mkdir -p /opt/prebuilt/Inference_Time_Tester /opt/prebuilt/Feature_Extractor

############################
# runtime stage
############################
FROM ${BASE_IMAGE} AS runtime
ENV DEBIAN_FRONTEND=noninteractive

# NVIDIA Jetson apt repo 추가 (TensorRT 등 설치용)
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gnupg wget && \
    wget -qO- https://repo.download.nvidia.com/jetson/jetson-ota-public.asc | gpg --dearmor -o /usr/share/keyrings/nvidia-jetson-ota.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/nvidia-jetson-ota.gpg] https://repo.download.nvidia.com/jetson/common r36.4 main" > /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    echo "deb [signed-by=/usr/share/keyrings/nvidia-jetson-ota.gpg] https://repo.download.nvidia.com/jetson/t234 r36.4 main" >> /etc/apt/sources.list.d/nvidia-l4t-apt-source.list && \
    apt-get update

# runtime deps (torch/pycuda 실행에 필요한 것들)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv python3-pip \
    libopencv-dev \
    libopenblas-base libopenmpi-dev libomp-dev \
    nvidia-tensorrt nvidia-tensorrt-dev \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv
COPY --from=build /opt/prebuilt /opt/prebuilt
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV PATH=/opt/venv/bin:$PATH
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash"]
